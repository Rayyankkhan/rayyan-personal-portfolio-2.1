# Copy to .env.local (and add the same keys in Vercel -> Project -> Settings -> Environment Variables)
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app
NEXT_PUBLIC_EMAIL=you@example.com
# Create a free form at https://formspree.io and paste the form id (the part after /f/)
NEXT_PUBLIC_FORMSPREE_ID=
# Optional booking link (Calendly / Cal.com)
NEXT_PUBLIC_BOOKING_URL=
# Optional WhatsApp number in international format, digits only (e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP=
